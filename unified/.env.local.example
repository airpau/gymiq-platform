# Twilio (WhatsApp + SMS + Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_SMS_NUMBER=

# Messaging master kill switch — leave empty (or 'false') until WhatsApp is
# approved by Meta AND you've explicitly tested. When unset, every Twilio
# send returns { dryRun: true } and nothing leaves the door.
MESSAGING_LIVE=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL="GymIQ <audit@gymiq.ai>"

# App
NEXT_PUBLIC_APP_URL=https://app.gymiq.ai

# Random string — used to authorise manual curl hits to /api/cron/*.
# Vercel Cron itself sends its own x-vercel-cron-signature header, so this
# is only needed for testing the cron endpoint from the command line.
CRON_SECRET=

# Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
