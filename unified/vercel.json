{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/sequences",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/abandoned-leads",
      "schedule": "*/15 * * * *"
    }
  ]
}
