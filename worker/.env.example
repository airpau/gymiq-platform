# Local runs: copy to worker/.env, then `set -a; . ./.env; set +a`.
# In production ONLY DATABASE_URL is a Fly secret; the rest come from Supabase Vault
# (gymiq_worker_secret, anthropic_api_key, resend_api_key). Env vars here override Vault.
DATABASE_URL=postgresql://postgres.fugixpfgwhnmhtttdzym:PASSWORD@aws-1-eu-west-2.pooler.supabase.com:5432/postgres
# WORKER_SECRET=
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
PLAYBOOK_MODEL=claude-haiku-4-5
MAX_BUDGET_USD=0.50
RESEND_FROM=gymIQ <brief@gymiq.ai>
PORT=8080
SCRATCH_DIR=/tmp/gymiq-worker
